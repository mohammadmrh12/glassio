<?xml version="1.0" encoding="utf-8"?>
<!-- Apple's aerial videos (sylvan.apple.com) use Apple's own root, which Android does not ship. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
    <domain-config>
        <domain includeSubdomains="false">sylvan.apple.com</domain>
        <!-- Apple's own root is in no public transparency log (checked by default from Android 17). -->
        <certificateTransparency enabled="false" />
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/apple_root_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
