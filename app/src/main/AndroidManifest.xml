<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The phone page answers to the TV's name on the home network (multicast DNS). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Android 17: reaching the home network (the phone page, Hue, cameras, other TVs, the TV's own adb). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- "Open Glassio when the TV starts": the boot receiver opens Glassio (allowed once ADB grants the overlay right). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Granted once over adb: lets Glass keep its Home-button service enabled after updates. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" xmlns:tools="http://schemas.android.com/tools" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <!-- The TV's channels (the rows apps publish for the home screen), shown in the carousel's place: Settings → Channels. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS"/>
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA"/>
    <uses-permission android:name="com.android.providers.tv.permission.ACCESS_ALL_EPG_DATA" xmlns:tools="http://schemas.android.com/tools" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"/>
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" xmlns:tools="http://schemas.android.com/tools" tools:ignore="ProtectedPermissions"/>
    <!-- Updates from GitHub Releases (fallback path; the TV's adb shell is tried first). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <!-- CHANGE_WIFI_MULTICAST_STATE (the phone page's name on the network) would make Wi-Fi required: TVs on a cable
         only dropped out of Google Play's list (6 in the 4.4.0 review). The name works without Wi-Fi too. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false"/>

    <queries>
        <!-- Fire TV: where its Settings actions end (Amazon's stand-in that starts its home: #29). -->
        <package android:name="com.amazon.tv.settings.v2"/>
        <package android:name="com.amazon.tv.launcher"/>
        <!-- Glassio's other build (GitHub ↔ Play): Restore backup can take its settings (BackupProvider). -->
        <package android:name="com.glasslauncher.tv"/>
        <package android:name="com.glasslauncher.tv.play"/>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent>
        <!-- The home apps: problem reports say which one the TV has (#46: two home screens taking turns). -->
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/></intent>
        <!-- The apps that open YouTube's links (the search's YouTube videos: SmartTube's forks too, #51), and the
             browsers, to leave those out. -->
        <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="https" android:host="www.youtube.com"/></intent>
        <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="https" android:host="youtu.be"/></intent>
        <intent><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.BROWSABLE"/><data android:scheme="https"/></intent>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
        <intent><action android:name="org.adw.launcher.THEMES"/></intent>
        <intent><action android:name="com.novalauncher.THEME"/></intent>
        <intent><action android:name="com.gau.go.launcherex.theme"/></intent>
        <intent><action android:name="org.adw.launcher.icons.ACTION_PICK_ICON"/></intent>
        <package android:name="space.nuvio.nativelegacy"/>
        <package android:name="com.nuvio.tv"/>
        <package android:name="com.nuvio.app"/>
        <package android:name="com.nuvioreshaped.tv"/>
        <package android:name="app.onetube.tv"/>
        <package android:name="com.nuvio.livetv"/>
        <package android:name="org.jellyfin.androidtv"/>
    </queries>

    <application
        android:largeHeap="true"
        android:name=".GlassApp"
        android:allowBackup="false"
        android:banner="@drawable/ic_banner_glass"
        android:icon="@drawable/ic_launcher_glass"
        android:label="@string/app_name"
        android:theme="@style/Theme.Glass"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true">
        <!-- Lets the TV's own profiler (simpleperf) see where time goes in this build; nothing else changes. -->
        <profileable android:shell="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:stateNotNeeded="true"
            android:excludeFromRecents="false"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".InputActivity"
            android:exported="false"
            android:theme="@style/Theme.Glass.Saver"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|orientation|uiMode"/>

        <activity
            android:name=".saver.ScreensaverActivity"
            android:exported="false"
            android:theme="@style/Theme.Glass.Saver"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|orientation|uiMode"/>

        <service
            android:name=".saver.GlassDreamService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </service>

        <service
            android:name=".data.MusicListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <service
            android:name=".HomeKeyService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config"/>
        </service>
            <receiver android:name=".data.InstallResultReceiver" android:exported="false"/>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <activity
            android:name=".InputsPickActivity"
            android:taskAffinity="com.glasslauncher.tv.inputs"
            android:exported="false"
            android:theme="@style/Theme.Glass.Recents"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />
        <activity
            android:name=".RecentsActivity"
            android:exported="false"
            android:theme="@style/Theme.Glass.Recents"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=".recents"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|orientation|uiMode"/>
        <!-- This TV's settings for Glassio's other build only (it checks the caller's package and signature). -->
        <provider
            android:name=".data.BackupProvider"
            android:authorities="${applicationId}.backup"
            android:exported="true" />
    </application>
</manifest>
